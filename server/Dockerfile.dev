# Dev-only image for running the backend test suite in a container.
#
# The shipped image (../Dockerfile) installs with `uv sync --no-dev` and drops
# the build toolchain, so it cannot run pytest. This mirrors the runtime stage's
# base digest and system libraries, then keeps the dev dependency group.
FROM python:3.14-alpine@sha256:26730869004e2b9c4b9ad09cab8625e81d256d1ce97e72df5520e806b1709f92

# Runtime libraries for cairosvg/pillow, plus the toolchain needed to build the
# wheels. Unlike the production image these are kept: tests rebuild on demand.
RUN apk add --no-cache \
    cairo \
    pango \
    gdk-pixbuf \
    shared-mime-info \
    gcc \
    musl-dev \
    cairo-dev \
    pango-dev \
    gdk-pixbuf-dev \
    libffi-dev

# Same hash-pinned uv the production image uses.
COPY --from=ghcr.io/astral-sh/uv:0.11.26@sha256:3d868e555f8f1dbc324afa005066cd11e1053fc4743b9808ca8025283e65efa5 /uv /uvx /usr/local/bin/

WORKDIR /app/server

# The source is bind-mounted at run time; this layer only warms the dependency
# cache so `uv sync` is fast on the first `docker compose run`.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen || true

CMD ["uv", "run", "pytest"]
